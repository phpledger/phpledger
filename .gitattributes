# Auto detect text files and perform LF normalization
* text=auto

# Migration checksums must remain identical on Windows and Linux checkouts.
www/phpledger/install/migrations/*.php text eol=lf
*.sh text eol=lf

# Signed release metadata must be served byte-identical to the GitHub asset; never convert its line endings.
www/website/src/static/releases/*.update.json -text
www/website/public/releases/*.update.json -text

# Custom for Visual Studio
*.cs     diff=csharp

# Standard to msysgit
*.doc	 diff=astextplain
*.DOC	 diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF	 diff=astextplain
*.rtf	 diff=astextplain
*.RTF	 diff=astextplain
