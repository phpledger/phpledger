  <!-- Translatable strings referenced elsewhere in this package via
       {{key}} placeholders (install.xml, install.js, upgrade.xml). The
       exact nesting Softaculous expects under <languages> (a language code
       wrapping the keys, vs. keys each wrapping language codes) was not
       shown verbatim in the fetched developer docs. This nesting - keys
       directly under a language-code element - is our best-effort reading
       of "Language strings using format: <language-key>Value</language-key>"
       and should be checked against a real accepted package before
       submission. See NOTES.md. -->
  <languages>
    <english>
      <overview><![CDATA[
        <p>PHP Ledger is self-hosted, double-entry accounting software for
        small businesses: sales, purchases, cash, and the general ledger,
        built on plain PHP and MySQL with no SaaS dependency.</p>
      ]]></overview>
      <features><![CDATA[
        <ul>
          <li>Double-entry general ledger with fixed-precision money</li>
          <li>Sales, purchases, and point-of-sale cash entry</li>
          <li>Company/book-scoped permissions and audit trail</li>
          <li>Runs on ordinary PHP + MySQL hosting, no CLI required to use it</li>
        </ul>
      ]]></features>
      <admin_settings>Administrator account</admin_settings>
      <admin_email>Administrator email</admin_email>
      <admin_email_exp>Used for sign-in and account recovery.</admin_email_exp>
      <admin_name>Administrator name</admin_name>
      <admin_name_exp>The display name for the first account.</admin_name_exp>
      <admin_username>Administrator username (optional)</admin_username>
      <admin_username_exp>Leave blank to sign in with the email address only.</admin_username_exp>
      <admin_pass>Administrator password</admin_pass>
      <admin_pass_exp>Used only to create the first account; never stored by this package.</admin_pass_exp>
      <db_port>Database port</db_port>
      <db_port_exp>Leave as 3306 unless the database server uses a different port.</db_port_exp>
    </english>
