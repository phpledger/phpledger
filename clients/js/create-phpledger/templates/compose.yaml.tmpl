# Generated by create-phpledger from compose.production.yaml (docs/CONTAINER.md).
# Pulls the published image; it never builds from source. PL_VERSION is pinned to
# the stable release resolved when this file was generated, not "latest", so an
# upgrade is a deliberate `docker compose pull` plus the steps in README.md, never
# a silent change underneath a running install.
name: phpledger
services:
  web:
    image: ${PL_IMAGE:-ghcr.io/phpledger/phpledger}:${PL_VERSION:-__PL_VERSION__}
    restart: unless-stopped
    ports:
      - "${PL_WEB_PORT:-8080}:8080"
    environment:
      PL_DB_HOST: db
      PL_DB_PORT: 3306
      PL_DB_NAME: phpledger
      PL_DB_USER: phpledger
      PL_DB_PASSWORD: ${PL_DB_PASSWORD:?Set PL_DB_PASSWORD in .env}
      PL_PUBLIC_URL: ${PL_PUBLIC_URL:-http://127.0.0.1:8080}
      # Set once and reviewed, not left on for every ordinary restart: applies pending
      # migrations on start, for the run after a newer image tag is pulled.
      PL_AUTO_MIGRATE: ${PL_AUTO_MIGRATE:-0}
      # All three install from the environment on first start; leave them unset to
      # finish setup in the browser at /install instead (docs/CONTAINER.md).
      PL_ADMIN_EMAIL: ${PL_ADMIN_EMAIL:-}
      PL_ADMIN_NAME: ${PL_ADMIN_NAME:-}
      PL_ADMIN_USERNAME: ${PL_ADMIN_USERNAME:-}
      PL_ADMIN_PASSWORD: ${PL_ADMIN_PASSWORD:-}
      # A private setup key an operator can require before /install opens at all,
      # recommended once this is reachable from the public internet.
      PL_SETUP_KEY: ${PL_SETUP_KEY:-}
      PL_ALLOWED_ORIGINS: ${PL_ALLOWED_ORIGINS:-}
    volumes:
      - phpledger_private:/var/lib/phpledger
    depends_on:
      db:
        condition: service_healthy
    init: true
  db:
    image: mysql:8.4
    restart: unless-stopped
    # Simplifies trigger creation for the single account this compose file grants
    # every privilege to; see docs/INSTALLER.md for a narrower-privilege alternative.
    command: ["--log-bin-trust-function-creators=1"]
    environment:
      MYSQL_DATABASE: phpledger
      MYSQL_USER: phpledger
      MYSQL_PASSWORD: ${PL_DB_PASSWORD:?Set PL_DB_PASSWORD in .env}
      MYSQL_ROOT_PASSWORD: ${PL_DB_ROOT_PASSWORD:?Set PL_DB_ROOT_PASSWORD in .env}
    volumes:
      - phpledger_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u root --password=\"$$MYSQL_ROOT_PASSWORD\" --silent"]
      interval: 5s
      timeout: 5s
      retries: 30
volumes:
  phpledger_data:
  phpledger_private:
networks:
  default:
    ipam:
      config:
        - subnet: ${PL_DOCKER_SUBNET:-10.205.82.0/24}
