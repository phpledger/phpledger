# Copy to .env and replace both values with independent random passwords.
PL_WEB_PORT=18200
PL_DOCKER_SUBNET=10.203.82.0/24
PL_DB_PASSWORD=
PL_DB_ROOT_PASSWORD=

# Ordinary installations: immutable table namespace and optional verified database TLS.
# Leave empty to use the private installer setting (default pl_).
PL_DB_PREFIX=
PL_DB_SSL_CA=
PL_DB_SSL_VERIFY=true
PL_DB_SSL_CERT=
PL_DB_SSL_KEY=

# Optional anonymous installation notice. Set 0 to disable project contact.
PL_INSTALL_NOTICE=1
