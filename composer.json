{
  "name": "phpledger/phpledger",
  "description": "PHP Ledger revival: a country-neutral, self-hosted accounting foundation.",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-bcmath": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-fileinfo": "*",
    "league/oauth2-server": "9.4.1",
    "mcp/sdk": "0.8.1",
    "nyholm/psr7": "1.8.2",
    "sergeytsalkov/meekrodb": "3.1.5"
  },
  "require-dev": { "phpstan/phpstan": "2.2.14" },
  "config": { "sort-packages": true, "allow-plugins": false, "platform": { "php": "8.2.0" }, "process-timeout": 900 },
  "scripts": {
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "validate-samples": "php tools/validate-sample-data.php --self-test",
    "test": "php tests/run.php",
    "check": ["@lint", "@analyse", "@validate-samples", "@test"]
  }
}
